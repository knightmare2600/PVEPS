    <View>
      <Name>PVEPS.ContainerNetworkAdapter</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.ContainerNetworkAdapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Device</Label></TableColumnHeader>
          <TableColumnHeader><Label>InterfaceName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Bridge</Label></TableColumnHeader>
          <TableColumnHeader><Label>IPAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>VlanTag</Label></TableColumnHeader>
          <TableColumnHeader><Label>Connected</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Device</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InterfaceName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Bridge</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IPAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VlanTag</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Connected</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.CloudInit</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.CloudInit</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Drive</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>SshPublicKey</Label></TableColumnHeader>
          <TableColumnHeader><Label>IPConfig</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsPending</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Drive</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0} key(s)' -f @($_.SshPublicKey).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>($_.IPConfig | ForEach-Object { 'net{0}: {1}' -f $_.Index, (@($_.IPAddress, $_.IPv6Address) -ne $null -join ' ') }) -join '; '</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>IsPending</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Snapshot</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Snapshot</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Snapshot</Label></TableColumnHeader>
          <TableColumnHeader><Label>Created</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsCurrent</Label></TableColumnHeader>
          <TableColumnHeader><Label>IncludesMemory</Label></TableColumnHeader>
          <TableColumnHeader><Label>Parent</Label></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Snapshot</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Created</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsCurrent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IncludesMemory</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Parent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.VMGuest</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.VMGuest</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>HostName</Label></TableColumnHeader>
          <TableColumnHeader><Label>OSName</Label></TableColumnHeader>
          <TableColumnHeader><Label>IPAddress</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HostName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OSName</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.IPAddress -join ','</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.VMScriptResult</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.VMScriptResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
