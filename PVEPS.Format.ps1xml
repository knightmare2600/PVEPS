<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PVEPS.Connection</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Connection</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Server</Label></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>AuthType</Label></TableColumnHeader>
          <TableColumnHeader><Label>Release</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsConnected</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Server</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AuthType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Release</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsConnected</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Task</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Task</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitStatus</Label></TableColumnHeader>
          <TableColumnHeader><Label>StartTime</Label></TableColumnHeader>
          <TableColumnHeader><Label>EndTime</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExitStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StartTime</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EndTime</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Node</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Node</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cpus</Label></TableColumnHeader>
          <TableColumnHeader><Label>CpuUsagePercent</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryUsedGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryTotalGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>Uptime</Label></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Cpus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CpuUsagePercent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MemoryUsedGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MemoryTotalGB</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Uptime -and $_.Uptime.Ticks -gt 0) { '{0}d {1:hh\:mm}' -f $_.Uptime.Days, $_.Uptime }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.VM</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.VM</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cpus</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>DiskGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>Uptime</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tags</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Cpus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MemoryGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DiskGB</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Uptime -and $_.Uptime.Ticks -gt 0) { '{0}d {1:hh\:mm}' -f $_.Uptime.Days, $_.Uptime }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Tags -join ','</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Container</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Container</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cpus</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>DiskGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>Uptime</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tags</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Cpus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MemoryGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DiskGB</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Uptime -and $_.Uptime.Ticks -gt 0) { '{0}d {1:hh\:mm}' -f $_.Uptime.Days, $_.Uptime }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Tags -join ','</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Storage</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Storage</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Content</Label></TableColumnHeader>
          <TableColumnHeader><Label>Active</Label></TableColumnHeader>
          <TableColumnHeader><Label>CapacityGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>FreeGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>UsedPercent</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Content -join ','</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Active</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CapacityGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>FreeGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UsedPercent</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Pool</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Pool</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Comment</Label></TableColumnHeader>
          <TableColumnHeader><Label>Members</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Comment</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Members).Count</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.HardDisk</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.HardDisk</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Device</Label></TableColumnHeader>
          <TableColumnHeader><Label>Storage</Label></TableColumnHeader>
          <TableColumnHeader><Label>SizeGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>Volume</Label></TableColumnHeader>
          <TableColumnHeader><Label>SSD</Label></TableColumnHeader>
          <TableColumnHeader><Label>Discard</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Device</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Storage</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SizeGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Volume</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SSD</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Discard</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.CDDrive</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.CDDrive</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Device</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsoImage</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Device</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsoImage</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.VMNetworkAdapter</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.VMNetworkAdapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Device</Label></TableColumnHeader>
          <TableColumnHeader><Label>Model</Label></TableColumnHeader>
          <TableColumnHeader><Label>MacAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>Bridge</Label></TableColumnHeader>
          <TableColumnHeader><Label>VlanTag</Label></TableColumnHeader>
          <TableColumnHeader><Label>Connected</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Device</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Model</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MacAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Bridge</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VlanTag</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Connected</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.ContainerVolume</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.ContainerVolume</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>VMId</Label></TableColumnHeader>
          <TableColumnHeader><Label>VMName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Device</Label></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Storage</Label></TableColumnHeader>
          <TableColumnHeader><Label>SizeGB</Label></TableColumnHeader>
          <TableColumnHeader><Label>Volume</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>VMId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>VMName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Device</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Storage</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SizeGB</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Volume</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
