<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PVEPS.Connection</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Connection</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Server</Label></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>AuthType</Label></TableColumnHeader>
          <TableColumnHeader><Label>Release</Label></TableColumnHeader>
          <TableColumnHeader><Label>IsConnected</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Server</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AuthType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Release</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsConnected</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PVEPS.Task</Name>
      <ViewSelectedBy>
        <TypeName>PVEPS.Task</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitStatus</Label></TableColumnHeader>
          <TableColumnHeader><Label>StartTime</Label></TableColumnHeader>
          <TableColumnHeader><Label>EndTime</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExitStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StartTime</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EndTime</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
